@model ParkHub.Models.VehicleFormViewModel
@{
    ViewData["Title"] = "Add Vehicle";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Add Vehicle</h2>
        <p class="text-muted mb-0">Enter your vehicle details.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <partial name="_VehicleForm" model="Model" />
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
