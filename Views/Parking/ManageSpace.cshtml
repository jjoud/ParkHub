@model ParkHub.Models.ViewModels.ParkingAdminViewModel
@{
    ViewData["Title"] = "Manage Parking Space";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h3 class="mb-1">Manage Parking Space</h3>
                            <p class="text-muted mb-0">Edit the reservation and status for this parking space.</p>
                        </div>
                        <a class="btn btn-outline-secondary" asp-controller="Parking" asp-action="Index">Back to Areas</a>
                    </div>

                    <form asp-action="ManageSpace" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ParkingSpaceId" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Area</label>
                                <input class="form-control" asp-for="AreaName" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Space Number</label>
                                <input class="form-control" asp-for="SpaceNumber" />
                            </div>
                        </div>

                        <div class="form-check form-switch my-3">
                            <input class="form-check-input" type="checkbox" asp-for="Status" id="Status" />
                            <label class="form-check-label" for="Status">Reserved / Occupied</label>
                        </div>

                        <hr />

                        <h5 class="mb-3">Reservation Details</h5>
                        <input type="hidden" asp-for="ReservationId" />

                        <div class="mb-3">
                            <label class="form-label">Reserved By</label>
                            <input class="form-control" asp-for="ReservedBy" placeholder="Plate number or user name" />
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Start Time</label>
                                <input class="form-control" type="datetime-local" asp-for="StartTime" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">End Time</label>
                                <input class="form-control" type="datetime-local" asp-for="EndTime" />
                            </div>
                        </div>

                        <div class="row g-3 mt-3">
                            <div class="col-md-6">
                                <label class="form-label">Duration (hours)</label>
                                <input class="form-control" asp-for="DurationHours" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Total Price</label>
                                <input class="form-control" asp-for="TotalPrice" />
                            </div>
                        </div>

                        <div class="form-check form-switch mt-4">
                            <input class="form-check-input" type="checkbox" asp-for="ResetReservation" id="ResetReservation" />
                            <label class="form-check-label" for="ResetReservation">Reset / delete reservation and make space available</label>
                        </div>

                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Save changes</button>
                            <a class="btn btn-outline-danger" asp-controller="Parking" asp-action="Index">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
