@model ParkHub.Models.ParkingSpace
@{
    ViewData["Title"] = "Delete Parking Space";
}

<div class="container-fluid py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h1 class="h4 mb-3">Delete Parking Space</h1>
                    <p class="text-muted">Are you sure you want to delete this parking space?</p>
                    <dl class="row mb-4">
                        <dt class="col-sm-4">Area Name</dt>
                        <dd class="col-sm-8">@Model.AreaName</dd>
                        <dt class="col-sm-4">Space Number</dt>
                        <dd class="col-sm-8">@Model.SpaceNumber</dd>
                        <dt class="col-sm-4">Space Type</dt>
                        <dd class="col-sm-8">@Model.SpaceType</dd>
                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@(Model.Status ? "Reserved" : "Available")</dd>
                    </dl>
                    <form asp-action="Delete" asp-controller="Parking" method="post">
                        <input type="hidden" name="id" value="@Model.ParkingSpaceId" />
                        <button type="submit" class="btn btn-danger me-2">Delete</button>
                        <a asp-action="Index" asp-controller="Parking" class="btn btn-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
