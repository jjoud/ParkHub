@model ParkHub.Models.ParkingSpace
@{
    ViewData["Title"] = "Parking Details";
}

<div class="container-fluid py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <h1 class="h4 mb-1">Parking Details</h1>
                            <p class="text-muted mb-0">@Model.AreaName - @Model.SpaceNumber</p>
                        </div>
                        <span class="badge @(Model.Status ? "bg-danger" : "bg-success")">@(Model.Status ? "Reserved" : "Available")</span>
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-4">Area Name</dt>
                        <dd class="col-sm-8">@Model.AreaName</dd>
                        <dt class="col-sm-4">Space Number</dt>
                        <dd class="col-sm-8">@Model.SpaceNumber</dd>
                        <dt class="col-sm-4">Space Type</dt>
                        <dd class="col-sm-8">@Model.SpaceType</dd>
                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@(Model.Status ? "Reserved" : "Available")</dd>
                    </dl>

                    <div class="d-flex gap-2">
                        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.ParkingSpaceId">Edit</a>
                        <a class="btn btn-outline-secondary" asp-action="Index">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
