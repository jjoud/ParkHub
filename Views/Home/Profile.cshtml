@model ParkHub.Models.ReservationHistoryViewModel
@{
    ViewData["Title"] = "Profile";
    var userFullName = Model?.UserFullName ?? string.Empty;
    var userEmail = Model?.UserEmail ?? string.Empty;
    var vehicles = Model?.Vehicles ?? new List<ParkHub.Models.UserVehicleSummaryViewModel>();
    var recentReservations = (Model?.RecentReservations ?? new List<ParkHub.Models.RecentReservationItemViewModel>())
        .OrderByDescending(r => r.ReservationDate)
        .Take(2)
        .ToList();
}

<div class="container py-5">
    <!-- بطاقة بيانات المستخدم -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0 p-4">
                <h5 class="text-purple fw-bold mb-4">📋 Account Details</h5>
                <div class="mb-3">
                    <p class="text-muted mb-1"><small>Full Name</small></p>
                    <p class="h6">@userFullName</p>
                </div>
                <div>
                    <p class="text-muted mb-1"><small>Email Address</small></p>
                    <p class="h6">@userEmail</p>
                </div>
            </div>
        </div>

        <!-- بطاقة المركبات -->
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0 p-4">
                <h5 class="text-purple fw-bold mb-4">🚗 My Vehicles</h5>
                @if (vehicles.Any())
                {
                    <ul class="list-unstyled">
                        @foreach (var vehicle in vehicles)
                        {
                            <li class="mb-3 pb-3 border-bottom">
                                <span class="fw-semibold">@vehicle.VehicleType</span>
                                <p class="text-muted mb-1">Color: @vehicle.Color</p>
                                <p class="text-muted mb-0">Plate: <strong>@vehicle.PlateNumber</strong></p>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted text-center">No vehicles registered yet.</p>
                }
            </div>
        </div>
    </div>

    <!-- جدول الحجوزات (آخر سجلين فقط) -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0 p-4">
                <h5 class="text-purple fw-bold mb-4">📅 Recent Reservations</h5>
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Area</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentReservations.Any())
                            {
                                foreach (var item in recentReservations)
                                {
                                    <tr>
                                        <td>@item.ReservationDate.ToString("g")</td>
                                        <td>@item.AreaName</td>
                                        <td>@item.TotalPrice.ToString("C")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-muted text-center">No reservations found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm p-4 bg-purple-subtle">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="text-purple fw-bold mb-1">🧾 Profile Overview</h5>
                        <p class="text-muted mb-0">Quick summary of your account and recent activity.</p>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100 p-3">
                            <div class="text-muted small mb-2">Full Name</div>
                            <div class="fw-semibold">@userFullName</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100 p-3">
                            <div class="text-muted small mb-2">Email</div>
                            <div class="fw-semibold">@userEmail</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100 p-3">
                            <div class="text-muted small mb-2">Registered Vehicles</div>
                            <div class="fw-semibold">@vehicles.Count</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
