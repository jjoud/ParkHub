@model ParkHub.Models.User

@{
    ViewData["Title"] = "Register";
}

<div class="auth-page">
    <div class="auth-card shadow-lg">
        <div class="auth-illustration">
            <div class="auth-badge">ParkHub</div>
            <h1>Create your account</h1>
            <p>Start your ParkHub journey and keep your bookings organized.</p>
        </div>

        <div class="auth-form-panel">
            <h2>Create an account</h2>

            <form asp-controller="Account" asp-action="Register" method="post">
                <div class="mb-3">
                    <label class="form-label">Full name</label>
                    <input asp-for="FullName" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email address</label>
                    <input asp-for="Email" type="email" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Phone number</label>
                    <input asp-for="PhoneNumber" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input asp-for="PasswordHash" type="password" class="form-control" required />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">
                    Create account
                </button>
            </form>

            <div class="auth-footer">
                <span>Already have an account?</span>
                <a asp-controller="Account" asp-action="Login">Sign in</a>
            </div>
        </div>
    </div>
</div>