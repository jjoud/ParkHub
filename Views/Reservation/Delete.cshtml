@model ParkHub.Models.Reservation

@{
    ViewData["Title"] = "Delete Reservation";
}

<div class="container py-4">

    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">
                Delete Reservation
            </h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <strong>Warning!</strong><br />
                Are you sure you want to delete this reservation?
            </div>

            <dl class="row">

                <dt class="col-sm-3">
                    Area
                </dt>

                <dd class="col-sm-9">
                    @Model.ParkingSpace.AreaName
                </dd>

                <dt class="col-sm-3">
                    Parking Space
                </dt>

                <dd class="col-sm-9">
                    @Model.ParkingSpace.SpaceNumber
                </dd>

                <dt class="col-sm-3">
                    Vehicle
                </dt>

                <dd class="col-sm-9">
                    @Model.Vehicle.PlateNumber
                </dd>

                <dt class="col-sm-3">
                    Start Time
                </dt>

                <dd class="col-sm-9">
                    @Model.StartTime.ToString("f")
                </dd>

                <dt class="col-sm-3">
                    End Time
                </dt>

                <dd class="col-sm-9">
                    @Model.EndTime.ToString("f")
                </dd>

            </dl>

            <form asp-action="Delete">

                <input asp-for="ReservationId" type="hidden" />

                <button type="submit" class="btn btn-danger">
                    Delete
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>