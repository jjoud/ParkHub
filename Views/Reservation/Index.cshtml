@model IEnumerable<ParkHub.Models.Reservation>

@{
    ViewData["Title"] = "My Reservations";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-purple">My Reservations</h2>
            <p class="text-muted mb-0">
                View and manage all your parking reservations.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            New Reservation
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body text-center py-5">

                <i class="bi bi-calendar-x display-3 text-secondary"></i>

                <h4 class="mt-3">
                    No Reservations Found
                </h4>

                <p class="text-muted">
                    You don't have any reservations yet.
                </p>

            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>#</th>
                            <th>Parking Space</th>
                            <th>Vehicle</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Status</th>
                            <th>Total</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.ReservationId</td>

                                <td>
                                    @item.ParkingSpace.AreaName
                                    -
                                    @item.ParkingSpace.SpaceNumber
                                </td>

                                <td>
                                    @item.Vehicle.PlateNumber
                                </td>

                                <td>
                                    @item.StartTime.ToString("g")
                                </td>

                                <td>
                                    @item.EndTime.ToString("g")
                                </td>

                                <td>

                                    @if (item.ReservationStatus)
                                    {
                                        <span class="badge bg-success">
                                            Reserved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Completed
                                        </span>
                                    }

                                </td>

                                <td>
                                    @item.TotalPrice SAR
                                </td>

                                <td class="text-center">

                                    <a asp-action="Details"
                                       asp-route-id="@item.ReservationId"
                                       class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.ReservationId"
                                       class="btn btn-sm btn-outline-warning">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.ReservationId"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>